# Copia este archivo con el nombre .env, en la misma carpeta que servidor.mjs,
# y vuelve a arrancar el servidor.

# Clave de la API de Anthropic (https://console.anthropic.com). Es la que lee los
# boletos de la pestaña Resultados, y cada lectura se cobra en esa cuenta.
# Sin clave el panel funciona igual, pero no lee boletos.
ANTHROPIC_API_KEY=

# Modelo que lee los boletos.
# ANTHROPIC_MODEL=claude-sonnet-5

# Puerto. Si lo cambias, el panel pasa a estar en http://localhost:<puerto>.
# PORT=8787

# 127.0.0.1 = solo este ordenador. 0.0.0.0 lo abre a tu red, SIN CONTRASEÑA.
# HOST=127.0.0.1
